---
import Layout from "../layouts/Layout.astro";
const telegramBotToken = import.meta.env.PUBLIC_TELEGRAM_BOT_TOKEN ?? "";
const telegramChatId = import.meta.env.PUBLIC_TELEGRAM_CHAT_ID ?? "";
---

<Layout>
  <header class="nav" id="nav">
    <div class="nav-inner">
      <a class="logo" href="#top">autodm</a>
      <nav class="nav-links">
        <a href="#demo">Demo</a>
        <a href="#dashboard">Dashboard</a>
        <a href="#features">Features</a>
        <a href="#benefits">Why autodm</a>
        <a href="#pricing">Pricing</a>
      </nav>
      <div class="nav-right">
        <a class="btn" href="#pricing">Get a demo</a>
        <button class="hamburger" id="ham" aria-label="Menu">☰</button>
      </div>
    </div>
    <div class="mobile-menu" id="mm">
      <a href="#demo">Demo</a>
      <a href="#dashboard">Dashboard</a>
      <a href="#features">Features</a>
      <a href="#benefits">Why autodm</a>
      <a href="#pricing">Pricing</a>
      <a href="#pricing" class="btn">Get a demo</a>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="hero-bg" aria-hidden="true">
      <div class="bar bar-l1"></div><div class="bar bar-l2"></div><div class="bar bar-l3"></div>
      <div class="bar bar-l4"></div><div class="bar bar-l5"></div><div class="bar bar-l6"></div>
      <div class="bar bar-l7"></div><div class="bar bar-l8"></div><div class="bar bar-l9"></div>
      <div class="bar bar-l10"></div>
      <div class="bar bar-r1"></div><div class="bar bar-r2"></div><div class="bar bar-r3"></div>
      <div class="bar bar-r4"></div><div class="bar bar-r5"></div><div class="bar bar-r6"></div>
      <div class="bar bar-r7"></div><div class="bar bar-r8"></div><div class="bar bar-r9"></div>
    </div>
    <div class="hero-inner">
      <h1>Automated sales and support, where your customers are.</h1>
      <p class="hero-sub">Agents for Instagram, Email, WhatsApp, Telegram and Chat. They know your store, reply in seconds and bring in a human when it counts.</p>
      <div>
        <form class="email-form" data-capture>
          <input type="email" placeholder="Enter your work email" aria-label="Enter your work email" required />
          <button class="btn btn-big" type="submit">Get a demo</button>
        </form>
        <div class="form-success" role="status"></div>
        <p class="form-note">Free tailored demo · Live in your DMs in days · No credit card</p>
      </div>
      <div class="channels">
        <div class="channels-eyebrow">WORKS WHERE YOUR CUSTOMERS TALK</div>
        <div class="channel-pills">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>Instagram DMs</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Email</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>WhatsApp</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="11"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>Telegram</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>Chatbot</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Shopify</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>Custom sources</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="demo">
    <div class="kicker rv">1. Live demo · Instagram</div>
    <h2 class="h2 rv">Watch autodm sell like your best rep. <span class="gray">Real context. Real answers. Fast.</span></h2>
    <p class="lede rv">A customer messages at midnight about a product. autodm pulls live stock, shipping, reviews and past orders, then answers, recommends, discounts and closes. No scripts. No waiting. Switch tabs to see the same brain on every channel.</p>

    <div class="tabs rv" role="tablist" aria-label="Channels">
      <button class="tab on" data-ch="instagram" role="tab">Instagram</button>
      <button class="tab" data-ch="whatsapp" role="tab">WhatsApp</button>
      <button class="tab" data-ch="email" role="tab">Email</button>
    </div>

    <div class="demo-grid">
      <div class="phone-col rv">
        <div class="phone-wrap">
          <div class="phone">
            <div class="screen" data-ch="instagram">
              <div class="island"></div>
              <div class="ig-status"><span>9:41</span><span class="sicons"><span class="sig"><i></i><i></i><i></i></span><span class="batt"></span></span></div>
              <div class="ig-head" id="chat-head">
                <span class="back">‹</span>
                <div class="avatar"><div class="avatar-inner">G</div></div>
                <div class="ig-id">
                  <div class="ig-name">glowhaus <svg width="14" height="14" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#0095f6"/><path d="M8 12.5l2.5 2.5L16 9.5" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/></svg></div>
                  <div class="ig-active">Active now</div>
                </div>
                <div class="ig-tools">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                  <svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9z"/></svg>
                </div>
              </div>
              <div class="chat" id="chat" aria-live="polite"></div>
              <div class="ig-input">
                <span class="cam"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></span>
                <div class="field">Message...</div>
                <span class="ig-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="10" r="1.2" fill="#111" stroke="none"/><path d="M7 15c1 1.2 2.4 2 5 2s4-.8 5-2"/></svg></span>
                <span class="ig-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="check-card rv">
        <div class="check-eyebrow">WHY IT WORKED</div>
        <h3>What happened in this chat</h3>
        <p>Every reply is grounded in live business context, not a generic chatbot guess.</p>
        <div class="check"><span class="tick">✓</span><div><b>Live store context, in real time</b><small>Stock, variants, pricing, shipping, returns and tracking from Shopify and your docs.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Personalized picks</b><small>Right shade from skin type, last order and 2,300 plus reviews.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Objections to checkout</b><small>Makeup wear, returns and student discount handled, then a reserved checkout link.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Human backup, ready</b><small>Tricky chats loop in a human with the full transcript and order context.</small></div></div>
        <div class="ctx-grid">
          <span class="ctx"><i></i><span><b>Shopify</b> · 14 units · Medium Dewy</span></span>
          <span class="ctx"><i></i><span><b>Profile</b> · repeat buyer · 2 orders</span></span>
          <span class="ctx"><i></i><span><b>Returns</b> · easy 30 day</span></span>
          <span class="ctx"><i></i><span><b>Shipping</b> · Mumbai 2 to 3 days</span></span>
        </div>
        <div class="why-foot">
          <div><b>41s</b><span>to sale</span></div>
          <div><b>1</b><span>link clicked</span></div>
          <div><b>0</b><span>humans needed</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="dashboard">
    <div class="kicker rv">2. Command center</div>
    <h2 class="h2 rv">Every conversation, click and sale. <span class="gray">In one place.</span></h2>
    <p class="lede rv">The dashboard your team opens each morning. Volume, resolution, revenue and every thread across Instagram, email, WhatsApp, Telegram and site chat.</p>

    <div class="browser rv">
      <div class="browser-top">
        <div class="traffic"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i></div>
        <div class="browser-title">autodm overview</div>
        <div style="width:52px;flex:none"></div>
      </div>
      <div class="dash">
        <aside class="side">
          <div class="side-logo">autodm</div>
          <div class="side-item on"><span class="sdot"></span>Overview</div>
          <div class="side-item"><span class="sdot"></span>Inbox</div>
          <div class="side-item"><span class="sdot"></span>Sources</div>
          <div class="side-item"><span class="sdot"></span>Humans</div>
          <div class="side-sec">CHANNELS</div>
          <div class="side-item"><span class="sdot"></span>Instagram</div>
          <div class="side-item"><span class="sdot"></span>Email</div>
          <div class="side-item"><span class="sdot"></span>WhatsApp</div>
          <div class="side-item"><span class="sdot"></span>Telegram</div>
          <div class="side-item"><span class="sdot"></span>Chatbot</div>
          <div class="side-status">Shopify connected</div>
        </aside>
        <div class="main">
          <div class="main-head">
            <h3>Good evening, Glowhaus</h3>
            <span class="live">34 agents online</span>
          </div>
          <div class="kpis">
            <div class="kpi"><small>Total conversations</small><div class="n" data-count="18429">0</div><div class="d up">▲ 18.2% this month</div></div>
            <div class="kpi"><small>Resolved by AI</small><div class="n"><span data-count="94.2" data-dec="1">0</span>%</div><div class="d up">▲ 3.1 pts · no human needed</div></div>
            <div class="kpi"><small>Link clicks</small><div class="n" data-count="7812">0</div><div class="d up">▲ 24% · product links</div></div>
            <div class="kpi"><small>Sales attributed</small><div class="n">$<span data-count="128.4" data-dec="1">0</span>k</div><div class="d warn">● 5.8% to humans</div></div>
          </div>
          <div class="grid2">
            <div class="panel">
              <h4>Conversations · last 30 days</h4>
              <p>All channels · AI and escalated</p>
              <svg viewBox="0 0 560 180" width="100%" height="150" role="img" aria-label="Conversation volume chart">
                <defs>
                  <linearGradient id="ag" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#9664d6" stop-opacity=".4"/><stop offset="1" stop-color="#9664d6" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <g stroke="#efeae0" stroke-width="1">
                  <line x1="0" y1="40" x2="560" y2="40"/><line x1="0" y1="80" x2="560" y2="80"/><line x1="0" y1="120" x2="560" y2="120"/>
                </g>
                <path d="M0,140 C40,132 60,110 90,108 C120,106 140,120 170,112 C200,104 220,70 250,68 C280,66 300,90 330,84 C360,78 380,50 410,48 C440,46 470,60 500,52 C525,46 545,30 560,28 L560,180 L0,180 Z" fill="url(#ag)"/>
                <path d="M0,140 C40,132 60,110 90,108 C120,106 140,120 170,112 C200,104 220,70 250,68 C280,66 300,90 330,84 C360,78 380,50 410,48 C440,46 470,60 500,52 C525,46 545,30 560,28" fill="none" stroke="#7c4bc4" stroke-width="3" stroke-linecap="round"/>
                <circle cx="410" cy="48" r="6" fill="#7c4bc4" stroke="#fff" stroke-width="3"/>
              </svg>
              <div class="chart-meta"><span>● <b>AI resolved</b> 17,364</span><span>● <b>Escalated</b> 1,065</span><span style="margin-left:auto">avg reply <b>8s</b></span></div>
            </div>
            <div class="panel">
              <h4>Where customers talk</h4>
              <p>Share of conversations</p>
              <div class="donut-row">
                <svg viewBox="0 0 120 120" width="104" height="104" style="flex:none">
                  <circle cx="60" cy="60" r="46" fill="none" stroke="#f0ece3" stroke-width="17"/>
                  <circle cx="60" cy="60" r="46" fill="none" stroke="#111" stroke-width="17" stroke-dasharray="127.2 289" stroke-dashoffset="72" stroke-linecap="round"/>
                  <circle cx="60" cy="60" r="46" fill="none" stroke="#8a8578" stroke-width="17" stroke-dasharray="52 289" stroke-dashoffset="-55.2" stroke-linecap="round"/>
                  <circle cx="60" cy="60" r="46" fill="none" stroke="#16a34a" stroke-width="17" stroke-dasharray="43.4 289" stroke-dashoffset="-107.2" stroke-linecap="round"/>
                  <circle cx="60" cy="60" r="46" fill="none" stroke="#229ED9" stroke-width="17" stroke-dasharray="34.7 289" stroke-dashoffset="-150.5" stroke-linecap="round"/>
                  <circle cx="60" cy="60" r="46" fill="none" stroke="#9664d6" stroke-width="17" stroke-dasharray="31.8 289" stroke-dashoffset="-185.2" stroke-linecap="round"/>
                  <text x="60" y="67" text-anchor="middle" font-size="19" font-weight="800" font-family="Inter,sans-serif">44%</text>
                </svg>
                <div class="legend">
                  <span><i style="background:#111"></i>Instagram · 44%</span>
                  <span><i style="background:#8a8578"></i>Email · 18%</span>
                  <span><i style="background:#16a34a"></i>WhatsApp · 15%</span>
                  <span><i style="background:#229ED9"></i>Telegram · 12%</span>
                  <span><i style="background:#9664d6"></i>Chatbot · 11%</span>
                </div>
              </div>
              <p style="margin-top:12px">Median first reply <b style="color:#111">8s</b> · CSAT <b style="color:#111">4.8/5</b></p>
            </div>
          </div>
          <div class="panel">
            <h4>Recent threads</h4>
            <p>Live across channels</p>
            <div class="table-wrap">
            <table class="table">
              <thead><tr><th>Customer</th><th>Channel</th><th>Intent</th><th>Outcome</th><th>Time</th></tr></thead>
              <tbody>
                <tr><td><b>maya.skincare</b> · Mumbai</td><td>Instagram</td><td>Shade and shipping</td><td><span class="pill g">Sale · 1,899</span></td><td>41s</td></tr>
                <tr><td><b>jordan@mail</b> · Order 8123</td><td>Email</td><td>Where is my order</td><td><span class="pill g">Resolved</span></td><td>12s</td></tr>
                <tr><td><b>98200 00021</b> · Mumbai</td><td>WhatsApp</td><td>Bulk deal</td><td><span class="pill a">To human</span></td><td>1m</td></tr>
                <tr><td><b>priya.tg</b> · Delhi</td><td>Telegram</td><td>Discount code</td><td><span class="pill g">Sale · 1,499</span></td><td>26s</td></tr>
                <tr><td><b>visitor 4419</b> · Site</td><td>Chatbot</td><td>Return request</td><td><span class="pill p">Link clicked</span></td><td>19s</td></tr>
              </tbody>
            </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="dark-band" id="features">
    <div class="band-inner">
    <div class="kicker rv">3. Features</div>
    <h2 class="h2 rv">Everything you need to sell in chat. <span class="gray">Nothing you do not.</span></h2>
    <p class="lede rv">One system for every inbound message. Trained on your brand, shaped to your rules, live on every channel your customers use.</p>
    <div class="fgrid">
      <div class="bcard rv"><div class="bicon" style="background:#ede4ff"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-3-.4-4.2-1L3 20l1-5.3A8.5 8.5 0 1 1 21 11.5z"/><path d="M12 8v4M12 15.5h.01"/></svg></div><h3>Comment to DM</h3><p>Post comments and story replies become DMs automatically. Set keywords, send links, never miss buying intent.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#dcf5e5"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></div><h3>Agents that sell</h3><p>Recommend products, share live stock and close orders inside the chat. Discounts and links included.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#e0f2fe"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 5v4h4"/><path d="M12 8v4l2.5 2.5"/></svg></div><h3>Agents that support</h3><p>Answer shipping, return and order questions with live data in seconds. Order history always in view.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#ffedd5"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 8.5a3.5 3.5 0 0 1 0 6.8M18.5 14.5A6.5 6.5 0 0 1 21.5 20"/></svg></div><h3>Humans take over smoothly</h3><p>Tricky chats move to your team with full history attached. People step in exactly when needed.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#f1ece1"><svg viewBox="0 0 24 24" fill="#111"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg></div><h3>Trained on your brand</h3><p>Catalogue, policies, tone and past tickets shape every reply. It sounds like you, not a bot.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#ede4ff"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h7l-1 8 10-12h-7z"/></svg></div><h3>Knows your store live</h3><p>Stock, prices, orders and tracking sync in real time from Shopify and your tools.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#dcf5e5"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></div><h3>Connects to your stack</h3><p>Shopify, CRM, sheets and internal APIs. If your data lives somewhere, autodm can use it.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#e0f2fe"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8M12 18v4"/></svg></div><h3>See everything</h3><p>Every thread, click and sale in one calm view. Shape flows and rules your way.</p></div>
    </div>
    </div>
  </section>

  <section class="section" id="benefits">
    <div class="kicker rv">4. Why autodm</div>
    <h2 class="h2 rv">Support that pays for itself. <span class="gray">Sales that never sleep.</span></h2>
    <p class="lede rv">Inbound messages are buying intent. Answers in seconds with the right context turn interest into revenue.</p>
    <div class="bgrid">
      <div class="bcard rv"><div class="bicon" style="background:#ede4ff"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M13 2L3 14h7l-1 8 10-12h-7z"/></svg></div><div class="b-eyebrow">RESPONSE</div><h3>Replies in seconds</h3><p>Customers get answers in seconds, day and night, on every channel. No queues. No waiting for morning.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#dcf5e5"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M7 17L17 7M8 7h9v9"/></svg></div><div class="b-eyebrow">SALES</div><h3>Chats become checkouts</h3><p>Product picks with live stock and instant links turn casual questions into paid orders.</p></div>
