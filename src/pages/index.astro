---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- ================= NAV ================= -->
  <header class="nav" id="nav">
    <div class="nav-inner">
      <a class="logo" href="#top"><span class="logo-mark">=</span> autodm</a>
      <nav class="nav-links">
        <a href="#demo">Demo</a>
        <a href="#dashboard">Dashboard</a>
        <a href="#benefits">Why AutoDM</a>
        <a href="#pricing">Pricing</a>
      </nav>
      <div class="nav-right">
        <a class="signin" href="#pricing">Sign in</a>
        <form class="nav-pill" data-capture>
          <input type="email" placeholder="Enter email" aria-label="Enter email" required />
          <button class="btn" type="submit">Get a demo</button>
        </form>
        <button class="hamburger" id="ham" aria-label="Menu">☰</button>
      </div>
    </div>
    <div class="mobile-menu" id="mm">
      <a href="#demo">Demo</a>
      <a href="#dashboard">Dashboard</a>
      <a href="#benefits">Why AutoDM</a>
      <a href="#pricing">Pricing</a>
      <a href="#pricing" class="btn">Get a demo</a>
    </div>
  </header>

  <!-- ================= HERO ================= -->
  <section class="hero" id="top">
    <div class="hero-bg" aria-hidden="true">
      <div class="bar bar-l1"></div><div class="bar bar-l2"></div><div class="bar bar-l3"></div>
      <div class="bar bar-l4"></div><div class="bar bar-l5"></div><div class="bar bar-l6"></div>
      <div class="bar bar-l7"></div><div class="bar bar-l8"></div><div class="bar bar-l9"></div>
      <div class="bar bar-l10"></div>
      <div class="bar bar-r1"></div><div class="bar bar-r2"></div><div class="bar bar-r3"></div>
      <div class="bar bar-r4"></div><div class="bar bar-r5"></div><div class="bar bar-r6"></div>
      <div class="bar bar-r7"></div><div class="bar bar-r8"></div><div class="bar bar-r9"></div>
    </div>
    <div class="hero-inner">
      <h1>Automated sales and support, where your customers are.</h1>
      <p class="hero-sub">AutoDM places AI sales &amp; support agents inside your Instagram DMs, email, WhatsApp and chatbot — with your Shopify store and custom data fetched in real time. Escalates to humans when it matters. Tailored to your brand.</p>
      <div>
        <form class="email-form" data-capture>
          <input type="email" placeholder="Enter your work email" aria-label="Enter your work email" required />
          <button class="btn btn-big" type="submit">Get a demo</button>
        </form>
        <div class="form-success" role="status"></div>
        <p class="form-note">Free tailored demo · Live in your DMs in days · No credit card</p>
      </div>
      <div class="channel-pills">
        <span><i class="dot" style="background:#E1306C"></i>Instagram DMs</span>
        <span><i class="dot" style="background:#555"></i>Email</span>
        <span><i class="dot" style="background:#25D366"></i>WhatsApp</span>
        <span><i class="dot" style="background:#9664d6"></i>Chatbot</span>
        <span><i class="dot" style="background:#5c6ac4"></i>Shopify</span>
        <span><i class="dot" style="background:#ff4b1e"></i>Custom sources</span>
      </div>
    </div>
  </section>

  <!-- ================= 1. DEMO / IG ================= -->
  <section class="section" id="demo">
    <div class="kicker rv">1. Live demo — Instagram</div>
    <h2 class="h2 rv">Watch AutoDM sell like your best rep. <span class="gray">Real context. Real answers. Instantly.</span></h2>
    <p class="lede rv">A customer DMs at midnight about a product. AutoDM pulls live Shopify inventory, shipping rules, reviews and past orders — then answers, recommends, discounts and closes. No scripts. No waiting.</p>

    <div class="demo-grid">
      <div class="check-card rv">
        <h3>What just happened in that chat →</h3>
        <p>Every reply is grounded in your live business context — not a generic chatbot guess.</p>
        <div class="check"><span class="tick">✓</span><div><b>Live working context, fetched in real time</b><small>Inventory, variants, pricing, shipping, returns, tracking — from Shopify + your docs.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Personalised selling</b><small>Recommends a shade from skin type + last order + 2,300 reviews.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Objections → checkout</b><small>Makeup layering, returns, student discount — handled, then a reserved checkout link.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Human escalation, armed</b><small>Complex or angry? A human is looped in with the full transcript + order context.</small></div></div>
        <div class="ctx-row">
          <span class="ctx">◉ shopify: 14 units · Medium/Dewy</span>
          <span class="ctx">◉ klaviyo: repeat buyer</span>
          <span class="ctx">◉ policy: 30-day returns</span>
          <span class="ctx">◉ ship: Mumbai 2–3d</span>
        </div>
      </div>

      <div class="rv">
        <div class="phone-wrap">
          <div class="phone">
            <div class="screen">
              <div class="ig-top">
                <div class="ig-status"><span>9:41</span><span>●●● ▮</span></div>
                <div class="ig-profile">
                  <div class="avatar"><div class="avatar-inner">G</div></div>
                  <div><div class="ig-name">glowhaus ✓</div><div class="ig-active">Active now · replies instantly</div></div>
                  <span class="ig-live">✦ auto</span>
                </div>
              </div>
              <div class="chat" id="chat" aria-live="polite"></div>
              <div class="ig-input"><div class="field">Message…</div><span class="ig-heart">♡</span></div>
            </div>
          </div>
        </div>
        <div class="chat-controls">
          <button class="ghost-btn" id="replay">↻ Replay conversation</button>
          <div class="float-note" id="chat-status">● live · median reply 8s</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 2. DASHBOARD ================= -->
  <section class="section" id="dashboard">
    <div class="kicker rv">2. Command center</div>
    <h2 class="h2 rv">Every conversation, click and sale. <span class="gray">In one place.</span></h2>
    <p class="lede rv">The dashboard your team actually opens every morning — volume, resolution, revenue and every thread across Instagram, email, WhatsApp and your site chatbot.</p>

    <div class="browser rv">
      <div class="browser-bar">
        <div class="traffic"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i></div>
        <div class="url">🔒 autodm.app/overview</div>
        <div style="width:60px"></div>
      </div>
      <div class="dash">
        <aside class="side">
          <div class="side-logo">= autodm</div>
          <div class="side-item on">◧ Overview</div>
          <div class="side-item">✉ Inbox</div>
          <div class="side-item">◈ Automations</div>
          <div class="side-item">⧉ Sources</div>
          <div class="side-item">◐ Humans</div>
          <div class="side-sec">CHANNELS</div>
          <div class="side-item">◎ Instagram</div>
          <div class="side-item">✉ Email</div>
          <div class="side-item">◉ WhatsApp</div>
          <div class="side-item">⬣ Chatbot</div>
          <div class="side-sec">STORE</div>
          <div class="side-item">🛍 Shopify · Connected</div>
        </aside>
        <div class="main">
          <div class="main-head">
            <h3>Good evening, Glowhaus 👋</h3>
            <span class="live">● 34 agents online</span>
          </div>
          <div class="kpis">
            <div class="kpi"><small>Total conversations</small><div class="n" data-count="18429">0</div><div class="d up">▲ 18.2% this month</div></div>
            <div class="kpi"><small>Resolved by AI</small><div class="n"><span data-count="94.2" data-dec="1">0</span>%</div><div class="d up">▲ 3.1 pts · no human needed</div></div>
            <div class="kpi"><small>Link clicks</small><div class="n" data-count="7812">0</div><div class="d up">▲ 24% · product links</div></div>
            <div class="kpi"><small>Sales attributed</small><div class="n">$<span data-count="128.4" data-dec="1">0</span>k</div><div class="d warn">● 5.8% escalated to humans</div></div>
          </div>
          <div class="grid2">
            <div class="panel">
              <h4>Conversations — last 30 days</h4>
              <p>All channels · AI vs escalated</p>
              <svg viewBox="0 0 560 180" width="100%" height="150" role="img" aria-label="Conversation volume chart">
                <defs>
                  <linearGradient id="ag" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#9664d6" stop-opacity=".45"/><stop offset="1" stop-color="#9664d6" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <g stroke="#eee" stroke-width="1">
                  <line x1="0" y1="40" x2="560" y2="40"/><line x1="0" y1="80" x2="560" y2="80"/><line x1="0" y1="120" x2="560" y2="120"/>
                </g>
                <path d="M0,140 C40,132 60,110 90,108 C120,106 140,120 170,112 C200,104 220,70 250,68 C280,66 300,90 330,84 C360,78 380,50 410,48 C440,46 470,60 500,52 C525,46 545,30 560,28 L560,180 L0,180 Z" fill="url(#ag)"/>
                <path id="area-line" d="M0,140 C40,132 60,110 90,108 C120,106 140,120 170,112 C200,104 220,70 250,68 C280,66 300,90 330,84 C360,78 380,50 410,48 C440,46 470,60 500,52 C525,46 545,30 560,28" fill="none" stroke="#7c4bc4" stroke-width="3" stroke-linecap="round"/>
                <circle cx="410" cy="48" r="6" fill="#7c4bc4" stroke="#fff" stroke-width="3"/>
              </svg>
              <div style="display:flex;gap:16px;font-size:12.5px;color:#666"><span>● <b>AI resolved</b> 17,364</span><span>● <b style="color:#e8930c">Escalated</b> 1,065</span><span style="margin-left:auto">avg reply <b>8s</b></span></div>
            </div>
            <div class="panel">
              <h4>Where customers talk</h4>
              <p>Share of conversations</p>
              <div class="donut-row">
                <svg viewBox="0 0 120 120" width="110" height="110">
                  <circle cx="60" cy="60" r="48" fill="none" stroke="#f0ece3" stroke-width="18"/>
                  <circle cx="60" cy="60" r="48" fill="none" stroke="#E1306C" stroke-width="18" stroke-dasharray="156.6 301.6" stroke-dashoffset="75" stroke-linecap="round"/>
                  <circle cx="60" cy="60" r="48" fill="none" stroke="#9664d6" stroke-width="18" stroke-dasharray="63.3 301.6" stroke-dashoffset="-96.6" stroke-linecap="round"/>
                  <circle cx="60" cy="60" r="48" fill="none" stroke="#25D366" stroke-width="18" stroke-dasharray="51.3 301.6" stroke-dashoffset="-164.9" stroke-linecap="round"/>
                  <text x="60" y="66" text-anchor="middle" font-size="18" font-weight="800">52%</text>
                </svg>
                <div class="legend">
                  <span><i style="background:#E1306C"></i>Instagram · 52%</span>
                  <span><i style="background:#555"></i>Email · 21%</span>
                  <span><i style="background:#25D366"></i>WhatsApp · 17%</span>
                  <span><i style="background:#9664d6"></i>Chatbot · 10%</span>
                </div>
              </div>
              <p style="margin-top:12px">Median first reply <b style="color:#111">8s</b> · CSAT <b style="color:#111">4.8/5</b></p>
            </div>
          </div>
          <div class="panel">
            <h4>Recent threads</h4>
            <p>Live across channels · click any row to open transcript</p>
            <div style="overflow-x:auto">
            <table class="table">
              <thead><tr><th>Customer</th><th>Channel</th><th>Intent</th><th>Outcome</th><th>Time</th></tr></thead>
              <tbody>
                <tr><td><b>@maya.skincare</b> · Mumbai</td><td>Instagram</td><td>Shade + shipping</td><td><span class="pill g">Sale · ₹1,899</span></td><td>41s</td></tr>
                <tr><td><b>jordan@mail</b> · Order #8123</td><td>Email</td><td>Where is my order?</td><td><span class="pill g">Resolved</span></td><td>12s</td></tr>
                <tr><td><b>+91 982·· ···21</b></td><td>WhatsApp</td><td>Bulk / collab deal</td><td><span class="pill a">Escalated → human</span></td><td>1m</td></tr>
                <tr><td><b>site visitor 4419</b></td><td>Chatbot</td><td>Return request</td><td><span class="pill p">Link clicked</span></td><td>19s</td></tr>
              </tbody>
            </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 3. BENEFITS ================= -->
  <section class="section" id="benefits">
    <div class="kicker rv">3. Why AutoDM</div>
    <h2 class="h2 rv">Support that pays for itself. <span class="gray">Sales that never sleep.</span></h2>
    <p class="lede rv">Inbound DMs, emails and chats are buying intent. Answering in seconds — with the right context — is the difference between a sale and a scroll-past.</p>
    <div class="bgrid">
      <div class="bcard rv"><div class="bicon" style="background:#ede4ff">⚡</div><div class="bstat">8s</div><h3>Faster response rates</h3><p>Median first reply under 8 seconds, 24/7 — across Instagram, WhatsApp, email and chat. No more “we’ll get back in 2 business days.”</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#dcf5e5">↗</div><div class="bstat">+31%</div><h3>Improve sales</h3><p>Product links sent with live inventory + tailored picks convert browsing DMs into checkouts — tracked to the rupee and dollar.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#ffedd5">◍</div><div class="bstat">−63%</div><h3>Reduce costs</h3><p>94% of repetitive “price? size? shipping? return?” threads resolved by AI. Your humans only touch what actually needs them.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#ffe4ec">♥</div><div class="bstat">4.8/5</div><h3>Improve customer satisfaction</h3><p>Accurate, on-brand, personal answers — with order history in view — instead of copy-paste macros.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#e0f2fe">◎</div><div class="bstat">10×</div><h3>Boost productivity</h3><p>One dashboard for every channel. Summaries, link clicks and escalations ready before your team’s morning coffee.</p></div>
      <div class="bcard rv"><div class="bicon" style="background:#f1ece1">✦</div><div class="bstat">Human</div><h3>Escalation when it matters</h3><p>Complex requirements, VIPs, complaints — AutoDM hands over with full transcript, cart and context. Tailored to your rules.</p></div>
    </div>
    <div class="integ rv">
      <div>◉ Instagram DMs</div><div>✉ Email</div><div>◉ WhatsApp</div><div>⬣ Website chatbot</div><div>🛍 Shopify</div><div>⧉ Custom data sources</div>
    </div>
  </section>

  <!-- ================= PRICING / CONTACT ================= -->
  <section class="contact" id="pricing">
    <div class="kicker rv" style="text-align:center">4. Pricing</div>
    <h2 class="rv">Contact team.</h2>
    <p class="rv">Every brand is different — volume, channels, catalogue size. Tell us where to reach you and we’ll tailor a plan + live demo on your own DMs.</p>
    <div class="rv">
      <form class="email-form" data-capture>
        <input type="email" placeholder="Enter your work email" aria-label="Enter your work email" required />
        <button class="btn btn-big" type="submit">Contact team</button>
      </form>
      <div class="form-success" role="status"></div>
      <p class="form-note">We reply within 24 hours · No spam, ever · Your data stays yours</p>
    </div>
  </section>

  <!-- ================= FOOTER ================= -->
  <footer class="footer">
    <div class="giant">autodm <span class="eq">=</span></div>
    <div class="foot-base"><span>© 2026 AutoDM · Automated sales & support where your customers are</span><span>Instagram · Email · WhatsApp · Chatbot · Shopify</span></div>
  </footer>

  <script is:inline>
    // ---------- Instagram DM animation ----------
    const chat = document.getElementById('chat');
    const status = document.getElementById('chat-status');
    const script = [
      { from: 'them', text: 'hey!! is the Midnight Silk Serum back in stock? 😭' },
      { from: 'me', text: 'Hi Maya! Yes — restocked this morning in all 3 shades ✨ Want help picking yours?' },
      { from: 'them', text: 'yes pls! combination skin, shade medium? + shipping time to Mumbai?' },
      { from: 'sys', text: '⚡ fetched Shopify · inventory + shipping + past orders' },
      { from: 'me', text: 'Perfect — Medium / Dewy is your match for combination skin (loved in 2,300+ reviews + your last order). 14 units left. Mumbai delivery in 2–3 days, free over ₹999.' },
      { from: 'product' },
      { from: 'them', text: 'does it sit well under makeup? and returns?' },
      { from: 'me', text: 'Yes — 92% say it layers cleanly under makeup. 30-day no-questions returns with prepaid pickup 🤝' },
      { from: 'them', text: 'ok sold 😭 can i get 10% off? student budget lol' },
      { from: 'me', text: 'Done — STUDENT10 applied (−₹189). Reserved for 30 min 👇\nglowhaus.co/checkout/GH-8421' },
      { from: 'them', text: 'ordered!! thank you 🖤' },
      { from: 'me', text: 'Order #GH-8421 confirmed 🎉 Tracking here + email. I stay on — a human joins instantly if you ever need one.' },
      { from: 'sys', text: '✓ resolved by AI in 41s · link clicked · escalation armed' },
    ];
    function el(html, cls) { const d = document.createElement('div'); d.className = cls; d.innerHTML = html; return d; }
    function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
    function addMsg(m) {
      if (m.from === 'sys') { chat.appendChild(el(esc(m.text), 'sys')); }
      else if (m.from === 'product') {
        const c = document.createElement('div'); c.className = 'product-card';
        c.innerHTML = '<div class="product-img">🧴</div><div class="product-body"><b>Midnight Silk Serum — Medium / Dewy</b><p>₹1,899 · ★ 4.8 (2,312) · In stock</p><a class="product-btn" href="#demo">View product</a></div>';
        chat.appendChild(c);
      } else {
        const b = el(esc(m.text).replace(/\n/g,'<br>') + '<span class="meta">' + (m.from==='me' ? 'glowhaus · auto · now' : 'Maya · now') + '</span>', 'bubble ' + m.from);
        chat.appendChild(b);
      }
      chat.scrollTop = chat.scrollHeight;
    }
    let runId = 0;
    async function play() {
      const id = ++runId;
      chat.innerHTML = '';
      status.textContent = '● typing…';
      await new Promise(r => setTimeout(r, 700));
      for (const m of script) {
        if (id !== runId) return;
        if (m.from === 'me') {
          const t = document.createElement('div'); t.className = 'typing'; t.innerHTML = '<i></i><i></i><i></i>';
          chat.appendChild(t); chat.scrollTop = chat.scrollHeight;
          status.textContent = '● autodm is typing…';
          await new Promise(r => setTimeout(r, 850 + Math.random()*500));
          if (id !== runId) return;
          t.remove();
        } else {
          await new Promise(r => setTimeout(r, 650));
          if (id !== runId) return;
        }
        addMsg(m);
        status.textContent = m.from === 'sys' ? '⚡ live context synced' : '● live · median reply 8s';
      }
      status.textContent = '✓ resolved · replay ↻';
      await new Promise(r => setTimeout(r, 6000));
      if (id !== runId) return;
      play();
    }
    document.getElementById('replay').addEventListener('click', play);
    const cio = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) { play(); cio.disconnect(); } }), { threshold: 0.3 });
    chat && cio.observe(chat);

    // ---------- animated counters ----------
    function animCount(node) {
      const target = parseFloat(node.dataset.count); const dec = parseInt(node.dataset.dec || '0');
      const dur = 1400; const t0 = performance.now();
      function tick(t) {
        const p = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - p, 3);
        const v = target * e;
        node.textContent = dec ? v.toFixed(dec) : Math.round(v).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    const nio = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) { animCount(e.target); nio.unobserve(e.target); } }), { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach(n => nio.observe(n));
  </script>
</Layout>
