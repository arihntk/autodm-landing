  <script is:inline>
    const chat = document.getElementById('chat');
    const headEl = document.getElementById('chat-head');
    const screenEl = chat.closest('.screen');
    const VERIFIED = '<svg width="14" height="14" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#0095f6"/><path d="M8 12.5l2.5 2.5L16 9.5" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/></svg>';
    const TOOLS = '<div class="ig-tools">'
      + '<svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>'
      + '<svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9z"/></svg>'
      + '</div>';
    const HEADS = {
      instagram: '<span class="back">‹</span>'
        + '<div class="avatar"><div class="avatar-inner">G</div></div>'
        + '<div class="ig-id"><div class="ig-name">glowhaus ' + VERIFIED + '</div><div class="ig-active">Active now</div></div>'
        + TOOLS,
      whatsapp: '<span class="back">‹</span>'
        + '<div class="avatar"><div class="avatar-inner">G</div></div>'
        + '<div class="ig-id"><div class="ig-name">glowhaus ' + VERIFIED + '</div><div class="ig-active">online</div></div>'
        + TOOLS,
      email: '<span class="back">‹</span>'
        + '<div class="avatar" style="background:#0d0d0d"><div class="avatar-inner">G</div></div>'
        + '<div class="ig-id"><div class="ig-name">Inbox</div><div class="ig-active">glowhaus support</div></div>'
        + '<div class="ig-tools"><svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg></div>',
    };
    const SCRIPTS = {
      instagram: [
        { date: 'Today' },
        { them: 'hey!! is the Midnight Silk Serum back in stock' },
        { me: 'Hi Maya! Yes, restocked this morning in all 3 shades. Want help picking yours' },
        { them: 'yes please! combo skin, shade medium? plus shipping time to Mumbai' },
        { me: 'Perfect. Medium Dewy suits combo skin best, loved in 2,300 plus reviews and matches your last order. 14 units left. Mumbai delivery in 2 to 3 days, free over 999.' },
        { them: 'does it sit well under makeup? and returns?' },
        { me: 'Yes. 92% say it layers cleanly under makeup. Easy 30 day returns with prepaid pickup' },
        { them: 'ok sold. any 10% off? student budget' },
        { me: 'Done. STUDENT10 applied, your total drops by 189. Reserved for 30 min. glowhaus.co/checkout/GH8421' },
        { them: 'ordered!! thank you' },
        { me: 'Order GH 8421 confirmed. Tracking here and on email. Talk soon.' },
      ],
      whatsapp: [
        { date: 'Today' },
        { them: 'hi! is the Midnight Silk Serum in stock in medium?' },
        { me: 'Hi Maya! Yes, Medium Dewy is in stock. 14 units left. Want me to reserve one?' },
        { them: 'yes please! how long to Mumbai?' },
        { me: '2 to 3 days, free shipping over 999. Here is your link: glowhaus.co/checkout/GH8421' },
        { them: 'ordered, thank you!' },
        { me: 'Confirmed. Tracking will reach you here and on email.' },
      ],
      email: [
        { date: 'Today' },
        { mail: 1, who: 'Maya', ini: 'M', time: '9:12 AM', sub: 'Shade help for Midnight Silk Serum', body: 'Hi team, I have combo skin. Which shade suits me? Also, how long is delivery to Mumbai?' },
        { mail: 1, brand: 1, who: 'glowhaus', ini: 'G', time: '9:13 AM', sub: 'Re: Shade help for Midnight Silk Serum', body: 'Hi Maya, Medium Dewy suits combo skin best. In stock now. Mumbai delivery takes 2 to 3 days with free shipping over 999. Just reply to order and I will reserve a unit.' },
        { mail: 1, who: 'Maya', ini: 'M', time: '9:15 AM', sub: 'Re: Shade help for Midnight Silk Serum', body: 'Please reserve one. Placing my order now. Thanks!' },
      ],
    };
    function el(html, cls) { const d = document.createElement('div'); d.className = cls; d.innerHTML = html; return d; }
    function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    function smoothBottom() {
      try {
        if (isTouch) { chat.scrollTop = chat.scrollHeight; }
        else { chat.scrollTo({ top: chat.scrollHeight, behavior: 'smooth' }); }
      } catch(e) { try { chat.scrollTop = chat.scrollHeight; } catch(_e) {} }
    }
    function addMail(m) {
      const c = document.createElement('div'); c.className = 'mail-card';
      c.innerHTML = '<div class="mail-top"><span class="mail-av' + (m.brand ? ' brand' : '') + '">' + esc(m.ini) + '</span>'
        + '<span class="mail-name">' + esc(m.who) + '</span><span class="mail-time">' + esc(m.time) + '</span></div>'
        + '<p class="mail-sub">' + esc(m.sub) + '</p><p class="mail-body">' + esc(m.body) + '</p>';
      chat.appendChild(c);
      smoothBottom();
    }
    function addMsg(m, ch) {
      if (m.date) { chat.appendChild(el(esc(m.date), 'date-chip')); }
      else if (m.mail) { addMail(m); return; }
      else if (m.me) {
        const meta = ch === 'whatsapp' ? '<span class="meta ticks">✓✓</span>' : '';
        chat.appendChild(el(esc(m.text) + meta, 'bubble me'));
      } else {
        chat.appendChild(el(esc(m.text), 'bubble them'));
      }
      smoothBottom();
    }
    function wait(ms) { return new Promise((r) => setTimeout(r, ms)); }
    let channel = 'instagram';
    let runId = 0;
    async function play() {
      const id = ++runId;
      const ch = channel;
      chat.innerHTML = '';
      await wait(250);
      for (const m of SCRIPTS[ch]) {
        if (id !== runId || ch !== channel) return;
        if (m.me || m.brand) {
          const t = document.createElement('div'); t.className = 'typing'; t.innerHTML = '<i></i><i></i><i></i>';
          chat.appendChild(t); smoothBottom();
          await wait(1900 + Math.random()*700);
          if (id !== runId || ch !== channel) return;
          t.remove();
        } else {
          await wait(1100);
          if (id !== runId || ch !== channel) return;
        }
        addMsg(m, ch);
        await wait(500);
        if (id !== runId || ch !== channel) return;
      }
      await wait(8000);
      if (id !== runId || ch !== channel) return;
      play();
    }
    headEl.innerHTML = HEADS.instagram;
    document.querySelectorAll('.tab').forEach((t) => {
      t.addEventListener('click', () => {
        if (t.dataset.ch === channel) return;
        channel = t.dataset.ch;
        document.querySelectorAll('.tab').forEach((x) => x.classList.toggle('on', x === t));
        screenEl.dataset.ch = channel;
        headEl.innerHTML = HEADS[channel];
        runId++;
        play();
      });
    });
    const cio = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) { play(); cio.disconnect(); } }), { threshold: 0.1, rootMargin: '0px 0px 250px 0px' });
    chat && cio.observe(chat);

    function animCount(node) {
      const target = parseFloat(node.dataset.count); const dec = parseInt(node.dataset.dec || '0');
      const dur = 1400; const t0 = performance.now();
      function tick(t) {
        const p = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - p, 3);
        const v = target * e;
        node.textContent = dec ? v.toFixed(dec) : Math.round(v).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    const nio = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) { animCount(e.target); nio.unobserve(e.target); } }), { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach(n => nio.observe(n));
  </script>

  <script is:inline define:vars={{ telegramBotToken, telegramChatId }}>
    // lead capture: posts each email to Telegram, falls back to local queue when not configured
    document.querySelectorAll('form[data-capture]').forEach((f) => {
      f.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const form = ev.currentTarget;
        const input = form.querySelector('input[type="email"]');
        const email = (input && input.value || '').trim();
        if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { if (input) { input.focus(); input.style.borderColor = 'red'; } return; }
        const btn = form.querySelector('button');
        const original = btn ? btn.textContent : '';
        if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }
        const section = form.closest('section');
        const source = section && section.id ? section.id : 'top';
        let sent = false;
        if (telegramBotToken && telegramChatId) {
          try {
            const text = 'New demo request\nEmail: ' + email + '\nForm: ' + source + '\nPage: ' + location.href + '\nTime: ' + new Date().toISOString();
            const res = await fetch('https://api.telegram.org/bot' + telegramBotToken + '/sendMessage', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ chat_id: telegramChatId, text: text }),
            });
            sent = res.ok;
          } catch (e) { sent = false; }
        } else {
          try { const k = 'autodm_waitlist'; const arr = JSON.parse(localStorage.getItem(k) || '[]'); arr.push({ email: email, at: new Date().toISOString() }); localStorage.setItem(k, JSON.stringify(arr)); } catch (e) {}
          sent = true;
        }
        const wrap = form.parentElement;
        const okBox = wrap && wrap.querySelector('.form-success');
        const note = wrap && wrap.querySelector('.form-note');
        if (sent) {
          if (okBox) { okBox.style.display = 'block'; okBox.textContent = 'You are on the list. We will reach out for your demo shortly.'; }
          form.style.display = 'none'; if (note) note.style.display = 'none';
        } else {
          if (btn) { btn.disabled = false; btn.textContent = original; }
          if (okBox) { okBox.style.display = 'block'; okBox.textContent = 'Something failed. Please try again in a moment.'; }
        }
      });
    });
  </script>
