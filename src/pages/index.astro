---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- ================= NAV ================= -->
  <header class="nav" id="nav">
    <div class="nav-inner">
      <a class="logo" href="#top"><span class="logo-mark">=</span> autodm</a>
      <nav class="nav-links">
        <a href="#demo">Demo</a>
        <a href="#dashboard">Dashboard</a>
        <a href="#benefits">Why AutoDM</a>
        <a href="#pricing">Pricing</a>
      </nav>
      <div class="nav-right">
        <a class="signin" href="#pricing">Sign in</a>
        <form class="nav-pill" data-capture>
          <input type="email" placeholder="Enter email" aria-label="Enter email" required />
          <button class="btn" type="submit">Get a demo</button>
        </form>
        <button class="hamburger" id="ham" aria-label="Menu">☰</button>
      </div>
    </div>
    <div class="mobile-menu" id="mm">
      <a href="#demo">Demo</a>
      <a href="#dashboard">Dashboard</a>
      <a href="#benefits">Why AutoDM</a>
      <a href="#pricing">Pricing</a>
      <a href="#pricing" class="btn">Get a demo</a>
    </div>
  </header>

  <!-- ================= HERO ================= -->
  <section class="hero" id="top">
    <div class="hero-bg" aria-hidden="true">
      <div class="bar bar-l1"></div><div class="bar bar-l2"></div><div class="bar bar-l3"></div>
      <div class="bar bar-l4"></div><div class="bar bar-l5"></div><div class="bar bar-l6"></div>
      <div class="bar bar-l7"></div><div class="bar bar-l8"></div><div class="bar bar-l9"></div>
      <div class="bar bar-l10"></div>
      <div class="bar bar-r1"></div><div class="bar bar-r2"></div><div class="bar bar-r3"></div>
      <div class="bar bar-r4"></div><div class="bar bar-r5"></div><div class="bar bar-r6"></div>
      <div class="bar bar-r7"></div><div class="bar bar-r8"></div><div class="bar bar-r9"></div>
    </div>
    <div class="hero-inner">
      <h1>Automated sales and support, where your customers are.</h1>
      <p class="hero-sub">AutoDM places AI sales &amp; support agents inside your Instagram DMs, email, WhatsApp and chatbot — with your Shopify store and custom data fetched in real time. Escalates to humans when it matters. Tailored to your brand.</p>
      <div>
        <form class="email-form" data-capture>
          <input type="email" placeholder="Enter your work email" aria-label="Enter your work email" required />
          <button class="btn btn-big" type="submit">Get a demo</button>
        </form>
        <div class="form-success" role="status"></div>
        <p class="form-note">Free tailored demo · Live in your DMs in days · No credit card</p>
      </div>
      <div class="channel-pills">
        <span><i class="dot" style="background:#E1306C"></i>Instagram DMs</span>
        <span><i class="dot" style="background:#555"></i>Email</span>
        <span><i class="dot" style="background:#25D366"></i>WhatsApp</span>
        <span><i class="dot" style="background:#9664d6"></i>Chatbot</span>
        <span><i class="dot" style="background:#5c6ac4"></i>Shopify</span>
        <span><i class="dot" style="background:#ff4b1e"></i>Custom sources</span>
      </div>
    </div>
  </section>

  <!-- ================= 1. DEMO / IG ================= -->
  <section class="section" id="demo">
    <div class="kicker rv">1. Live demo — Instagram</div>
    <h2 class="h2 rv">Watch AutoDM sell like your best rep. <span class="gray">Real context. Real answers. Instantly.</span></h2>
    <p class="lede rv">A customer DMs at midnight about a product. AutoDM pulls live Shopify inventory, shipping rules, reviews and past orders — then answers, recommends, discounts and closes. No scripts. No waiting.</p>

    <div class="demo-grid">
      <div class="check-card rv">
        <h3>What just happened in that chat →</h3>
        <p>Every reply is grounded in your live business context — not a generic chatbot guess.</p>
        <div class="check"><span class="tick">✓</span><div><b>Live working context, fetched in real time</b><small>Inventory, variants, pricing, shipping, returns, tracking — from Shopify + your docs.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Personalised selling</b><small>Recommends a shade from skin type + last order + 2,300 reviews.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Objections → checkout</b><small>Makeup layering, returns, student discount — handled, then a reserved checkout link.</small></div></div>
        <div class="check"><span class="tick">✓</span><div><b>Human escalation, armed</b><small>Complex or angry? A human is looped in with the full transcript + order context.</small></div></div>
        <div class="ctx-row">
          <span class="ctx">◉ shopify: 14 units · Medium/Dewy</span>
          <span class="ctx">◉ klaviyo: repeat buyer</span>
          <span class="ctx">◉ policy: 30-day returns</span>
          <span class="ctx">◉ ship: Mumbai 2–3d</span>
        </div>
      </div>

      <div class="rv">
        <div class="phone-wrap">
          <div class="phone">
            <div class="screen">
              <div class="ig-top">
                <div class="ig-status"><span>9:41</span><span>●●● ▮</span></div>
                <div class="ig-profile">
                  <div class="avatar"><div class="avatar-inner">G</div></div>
                  <div><div class="ig-name">glowhaus ✓</div><div class="ig-active">Active now · replies instantly</div></div>
                  <span class="ig-live">✦ auto</span>
                </div>
              </div>
              <div class="chat" id="chat" aria-live="polite"></div>
              <div class="ig-input"><div class="field">Message…</div><span class="ig-heart">♡</span></div>
            </div>
          </div>
        </div>
        <div class="chat-controls">
          <button class="ghost-btn" id="replay">↻ Replay conversation</button>
          <div class="float-note" id="chat-status">● live · median reply 8s</div>
        </div>
      </div>
    </div>
  </section>
</Layout>
