# Telegram lead alerts. Copy this file to `.env` and fill in your values, then rebuild.
# 1. Open Telegram, message @BotFather, send /newbot, follow the steps, copy the token.
# 2. Tap /start on your new bot (open a chat with it and press start).
# 3. Message @userinfobot on Telegram to get your numeric chat id.
PUBLIC_TELEGRAM_BOT_TOKEN=123456789:AAEXAMPLETOKEN
PUBLIC_TELEGRAM_CHAT_ID=123456789
